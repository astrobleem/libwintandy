@ECHO OFF
SET PATH=C:\BIN;C:\DOS
SET INCLUDE=C:\DDK\286\INC;C:\INCLUDE
SET LIB=C:\LIB
SET TMP=D:\TMP
D:
CD \MMLAB
CL /nologo /c /G0 /Gw /Gs /AS /W3 /Od INTERGUI.C > BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
C:\BIN\LINK4 /NOE /NOD @INTERGUI.RSP >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
CL /nologo /c /G0 /Gw /Gs /AS /W3 /Od EOFGUI.C >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
C:\BIN\LINK4 /NOE /NOD @EOFGUI.RSP >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
CL /nologo /c /G0 /Gw /Gs /AS /W3 /Od FULLGUI.C >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
C:\BIN\LINK4 /NOE /NOD @FULLGUI.RSP >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
ECHO PASS >> BUILD.LOG
GOTO END
:FAIL
ECHO FAIL >> BUILD.LOG
:END
ECHO DONE > D:\DONE.TXT
EXIT
