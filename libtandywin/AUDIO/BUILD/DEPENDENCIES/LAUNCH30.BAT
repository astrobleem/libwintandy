@ECHO OFF
SET PATH=C:\BIN;C:\DOS
SET INCLUDE=C:\INCLUDE
SET LIB=C:\LIB
CL /nologo /c /G0 /AS /W3 /Od TPLAY.C > LAUNCH.LOG
IF ERRORLEVEL 1 GOTO FAIL
MASM /MX DOSSTAT.ASM; >> LAUNCH.LOG
IF ERRORLEVEL 1 GOTO FAIL
LINK4 /NOE /NOD /CPARMAXALLOC:1024 @TPLAY.RSP >> LAUNCH.LOG
IF ERRORLEVEL 1 GOTO FAIL
ECHO PASS >> LAUNCH.LOG
GOTO END
:FAIL
ECHO FAIL >> LAUNCH.LOG
:END
