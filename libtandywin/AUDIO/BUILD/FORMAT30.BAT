@ECHO OFF
SET PATH=C:\BIN;C:\DOS
SET INCLUDE=C:\DDK\286\INC;C:\INCLUDE
SET LIB=C:\LIB
SET TMP=D:\TMP
D:
CD \MMLAB
CL /nologo /c /G0 /Gw /Gs /AS /W3 /Od MINIPLAY.C > BUILD.LOG
