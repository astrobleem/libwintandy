C:\BIN\LINK4 /NOE /NOD @FULLGUI.RSP >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
C:\BIN\LINK4 /NOE /NOD @RAWGUI.RSP >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
C:\BIN\LINK4 /NOE /NOD @GZIPGUI.RSP >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
ECHO PASS >> BUILD.LOG
GOTO END
:FAIL
ECHO FAIL >> BUILD.LOG
:END
ECHO DONE > D:\DONE.TXT
EXIT
