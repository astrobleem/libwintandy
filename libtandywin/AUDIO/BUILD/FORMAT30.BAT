MASM /MX WINHOOK.ASM; >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
C:\BIN\LINK4 /NOE /NOD @TIMECLK.RSP >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
C:\BIN\LINK4 /NOE /NOD @MINIPLAY.RSP >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
C:\BIN\LINK4 /NOE /NOD @INTERGUI.RSP >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
C:\BIN\LINK4 /NOE /NOD @EOFGUI.RSP >> BUILD.LOG
